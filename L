#!/usr/bin/env bash
#
# L — capture a command's output into $L.
#
# The first program I wrote saved whatever I had just typed in the terminal
# into a variable called $L, so I could hand it straight to the next
# command. This is that same idea done properly: a real variable in your
# real shell, not a separate program you have to enter and exit.
#
# Add this to your .bashrc (or .zshrc):
#   source /path/to/L
#
# Then just prefix anything you want to remember:
#   L curl -s ifconfig.me
#   echo my IP is $L
#
# Output prints normally and in real time, exactly as if you had run the
# command yourself — nothing extra gets printed. $L is left untouched when
# a command produces no output, and capped at 220 characters, matching the
# very first version of this trick.

if [ -n "${BASH_SOURCE:-}" ] && [ "${BASH_SOURCE[0]}" = "${0}" ]; then
  echo "L defines a shell function, so it needs to be sourced, not run:" >&2
  echo "  source ${BASH_SOURCE[0]}" >&2
  exit 1
fi

L() {
  local tmp out rc
  tmp="$(mktemp)" || return 1
  "$@" 2>&1 | tee "$tmp"
  rc=${PIPESTATUS[0]:-${pipestatus[1]}}
  out="$(tr '\n' ' ' < "$tmp" | sed -e 's/  */ /g' -e 's/^ //' -e 's/ $//')"
  rm -f "$tmp"
  [ -n "$out" ] && export L="${out:0:220}"
  return "$rc"
}
