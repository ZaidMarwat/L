#!/usr/bin/env bash
#
# L — capture a command's output into $L.
#
# The first program I wrote saved whatever I had just typed in the terminal
# into a variable called $L, so I could hand it straight to the next
# command. This is that same idea done properly: a real variable in your
# real shell, not a separate program you have to enter and exit.
#
# Add this to your .bashrc (or .zshrc):
#   source /path/to/L
#
# Then just prefix anything you want to remember -- your own aliases work
# too, the same way they do through sudo or time:
#   L curl -s ifconfig.me
#   L ll
#   echo my IP is $L
#
# $L is a real array, one element per line of output, so a multi-line
# result works as a list of arguments to your next command:
#   L ls
#   touch $L               # zsh: splices every item as its own word
#   touch "${L[@]}"        # bash: same thing, spelled the bash way --
#                           #   bare $L in bash only gives the first item
#
# Output prints normally and in real time, exactly as if you had run the
# command yourself — nothing extra gets printed. $L is left untouched when
# a command produces no output. No length cap: a line is a line, however
# long it is.

if [ -n "${BASH_SOURCE:-}" ] && [ "${BASH_SOURCE[0]}" = "${0}" ]; then
  echo "L defines a shell function, so it needs to be sourced, not run:" >&2
  echo "  source ${BASH_SOURCE[0]}" >&2
  exit 1
fi

[ -n "${BASH_VERSION:-}" ] && shopt -s expand_aliases 2>/dev/null

_L_run() {
  local tmp rc line
  tmp="$(mktemp)" || return 1
  "$@" 2>&1 | tee "$tmp"
  rc=${PIPESTATUS[0]:-${pipestatus[1]}}
  if [ -s "$tmp" ]; then
    L=()
    while IFS= read -r line || [ -n "$line" ]; do
      L+=("$line")
    done < "$tmp"
  fi
  rm -f "$tmp"
  return "$rc"
}

# The trailing space is load-bearing: it tells bash/zsh to also check the
# next word for alias expansion, so L composes with your own aliases
# instead of shadowing them.
alias L='_L_run '
